[Unit]
Description=Xray Client Web Manager（面板）
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/opt/xray-browser-dialer/scripts/run-panel.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xbd-panel

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# 诊断会读 nftables（`nft list table ...`，只读查询），而 nft 走 netlink ——
# 少了 AF_NETLINK 会报 "Unable to initialize Netlink socket"。
# （当年"接管局域网"模式要**写** nft 规则，这个坑就是那时踩出来的；模式已移除，
#   但只读查询仍然需要，所以保留。）其余保持收紧。
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# ProtectSystem=full 会把 /etc 与 /usr 挂成只读 —— 这对服务本身是好事，
# 但面板要代表用户执行"接管本机"，那些动作**必须**写 /etc：
#   /etc/profile.d/                     shell 代理环境变量
#   /etc/systemd/system/docker.service.d  docker 的代理覆盖
#   /etc/environment                    本机已有的系统代理（就地改写，不新增）
# 只放行这几个，其余 /etc 仍然只读。曾经漏了前两条，表现为：
#   点「接管本机」→ 界面毫无变化（动作其实失败了）→
#   日志里报 "/etc/profile.d/proxy.sh: Read-only file system"。
# 排查了很久才定位到是单元加固，不是功能没做。
ReadWritePaths=/opt/xray-browser-dialer/runtime /opt/xray-browser-dialer/logs /opt/xray-browser-dialer/config /opt/xray-browser-dialer/nodes /opt/xray-browser-dialer/generated /etc/profile.d /etc/systemd/system/docker.service.d /etc/environment

[Install]
WantedBy=multi-user.target
